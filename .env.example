# ---- Firebase 网页设定（Firebase 控制台 → 项目设置 → 你的应用）----
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---- Firebase 服务账号（项目设置 → 服务账号 → 生成新的私钥，整个 JSON 贴成一行）----
FIREBASE_SERVICE_ACCOUNT=

# ---- Google Calendar（Google Cloud → API 和服务 → 凭据 → OAuth 客户端 ID）----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- 其他 ----
# 网站正式网址，例如 https://abound-workbench.vercel.app
APP_URL=
# 第一位管理员（你的登录邮箱）
ADMIN_EMAIL=
# 随便一串长密码，用于每日定时任务
CRON_SECRET=
